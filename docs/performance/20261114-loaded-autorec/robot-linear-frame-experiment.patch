@@ -12,0 +13,35 @@
+namespace webrc::native {
+struct NativeRobotCoreTestAccess {
+    static void verifyAnalysisDifferences() {
+        for (unsigned int rate : {4000U, 8000U, 12000U}) {
+            NativeRobotCore::PitchTracker tracker;
+            assert(tracker.configure(rate));
+            std::uint32_t state = 1234567U;
+            unsigned int framesChecked = 0U;
+            for (unsigned int n = 0; n < 5000U; ++n) {
+                state = state * 1664525U + 1013904223U;
+                float sample = n < 1000U ? 0.0f : n < 2500U
+                    ? static_cast<float>(0.3 * std::sin(n * 0.123))
+                    : static_cast<float>(static_cast<int>(state >> 16U) - 32768) / 32768.0f;
+                const auto expectedAnalysis = tracker.nextAnalysisSample;
+                tracker.pushSample(sample);
+                if (tracker.sampleCount != expectedAnalysis) continue;
+                ++framesChecked;
+                const auto start = (tracker.writeIndex + NativeRobotCore::kDetectorRingCapacity - tracker.frameSamples)
+                    & NativeRobotCore::kDetectorRingMask;
+                for (unsigned int lag = 1; lag <= tracker.maximumLag; ++lag) {
+                    double expected = 0.0;
+                    for (unsigned int i = 0; i < tracker.analysisWindowSamples; ++i) {
+                        const double delta = static_cast<double>(tracker.ring[(start + i) & NativeRobotCore::kDetectorRingMask]) -
+                            static_cast<double>(tracker.ring[(start + i + lag) & NativeRobotCore::kDetectorRingMask]);
+                        expected += delta * delta;
+                    }
+                    assert(expected == tracker.differences[lag]);
+                }
+            }
+            assert(framesChecked > 0U);
+        }
+    }
+};
+} // namespace webrc::native
+
@@ -632,0 +668 @@ int main() {
+    NativeRobotCoreTestAccess::verifyAnalysisDifferences();
