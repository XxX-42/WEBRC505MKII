{
  "name": "webrc505mkii-v2",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "build:worklet": "esbuild src/audio/worklet/FxProcessor.ts --bundle --format=iife --target=es2022 --outfile=public/worklets/fx-processor.js",
    "build": "vue-tsc -b && npm run build:worklet && vite build && node scripts/verify-third-party-notices.mjs --built",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:archive:interop": "node scripts/test-project-archive-interop.mjs",
    "test:rhythm:parity": "vite-node --script bench/compare_rhythm_event_runtime.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:startup": "node scripts/measure-vite-cold-start.mjs",
    "test:watch-scope": "node scripts/check-vite-watch-scope.mjs",
    "test:e2e:rubberband": "node scripts/test-e2e-rubberband.mjs",
    "test:ci": "npm run build && npm run test:unit && npm run test:e2e",
    "bench:fx-quality": "vite-node bench/run_browser_fx_quality_sweep.ts",
    "preview": "vite preview",
    "native:configure": "cmake -S native-mvp/engine-cpp -B native-mvp/build-v145 -G \"Visual Studio 17 2022\" -T v145 -A x64",
    "native:build": "cmake --build native-mvp/build-v145 --config Release --target native_bridge_host"
  },
  "dependencies": {
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.4"
  }
}
