{
  "name": "webrc505mkii-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ci": "npm run build && npm run test:unit && npm run test:e2e",
    "preview": "vite preview",
    "audio:benchmark:hardware": "node scripts/audio-benchmark-hardware.mjs",
    "audio:benchmark:software": "node scripts/audio-benchmark-software.mjs",
    "audio:report:worklet": "node scripts/audio-benchmark-import-worklet.mjs",
    "audio:smoke:browser": "node scripts/browser-realtime-smoke.mjs",
    "audio:smoke:project-mix": "node scripts/project-mix-smoke.mjs",
    "audio:benchmark:fx": "node scripts/dsp-effects-benchmark.mjs",
    "audio:benchmark:worklet": "node scripts/worklet-benchmark.mjs",
    "audio:benchmark:time-stretch": "node scripts/time-stretch-benchmark.mjs",
    "native:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-verify.ps1",
    "native:benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-benchmark.ps1",
    "native:configure": "cmake -S native-mvp/engine-cpp -B native-mvp/build-v145 -G \"Visual Studio 17 2022\" -T v145 -A x64",
    "native:build": "cmake --build native-mvp/build-v145 --config Release --target native_bridge_host"
  },
  "dependencies": {
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.2.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.4"
  }
}
