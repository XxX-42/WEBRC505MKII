if(NOT DEFINED SOURCE OR NOT DEFINED BUILD)
  message(FATAL_ERROR "SOURCE and BUILD are required")
endif()
if(NOT EXISTS "${SOURCE}" OR NOT EXISTS "${BUILD}")
  message(FATAL_ERROR "Missing source or distributed file: ${SOURCE} -> ${BUILD}")
endif()
file(SHA256 "${SOURCE}" source_hash)
file(SHA256 "${BUILD}" build_hash)
if(NOT source_hash STREQUAL build_hash)
  message(FATAL_ERROR "Distributed file does not match source exactly: ${SOURCE}")
endif()
message(STATUS "Verified exact copy: ${BUILD}")
