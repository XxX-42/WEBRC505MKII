if(NOT DEFINED SOURCE_DIR OR NOT DEFINED BUILD_DIR)
  message(FATAL_ERROR "SOURCE_DIR and BUILD_DIR are required")
endif()

foreach(name IN ITEMS NOTICE.md SIGNALSMITH_STRETCH_LICENSE.txt SIGNALSMITH_LINEAR_LICENSE.txt)
  set(source "${SOURCE_DIR}/${name}")
  set(built "${BUILD_DIR}/${name}")
  if(NOT EXISTS "${source}")
    message(FATAL_ERROR "Missing source third-party notice: ${source}")
  endif()
  if(NOT EXISTS "${built}")
    message(FATAL_ERROR "Missing built third-party notice: ${built}")
  endif()
  file(SHA256 "${source}" source_hash)
  file(SHA256 "${built}" built_hash)
  if(NOT source_hash STREQUAL built_hash)
    message(FATAL_ERROR "Built notice differs from exact vendored source: ${name}")
  endif()
endforeach()

message(STATUS "Verified exact Signalsmith NOTICE and MIT license bundle at ${BUILD_DIR}")
